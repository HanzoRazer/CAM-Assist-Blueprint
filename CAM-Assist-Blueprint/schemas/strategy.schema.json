{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cam-assist.lutherie/schemas/strategy.schema.json",
  "title": "CAM Assist Strategy Package Schema",
  "description": "Defines the output strategy package from CAM Assist. Version 1.2 adds operation_intent, material_context, and safety_boundary for semantic contract enforcement.",
  "type": "object",
  "required": [
    "strategy_version",
    "strategy_id",
    "units",
    "coordinate_frame",
    "provenance",
    "operation_intent",
    "material_context",
    "safety_boundary",
    "geometry",
    "operation",
    "approval_state"
  ],

  "properties": {
    "strategy_version": {
      "type": "string",
      "const": "1.2",
      "description": "Schema version for this strategy format"
    },

    "strategy_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier for this strategy package"
    },

    "units": {
      "type": "string",
      "enum": ["inches", "mm"],
      "description": "Unit system for all dimensions in this strategy package"
    },

    "coordinate_frame": {
      "type": "object",
      "required": ["origin", "x_axis", "y_axis"],
      "description": "Coordinate system definition for geometry interpretation",
      "properties": {
        "origin": {
          "type": "string",
          "description": "Reference point for coordinate origin (e.g., nut_centerline, body_center)"
        },
        "x_axis": {
          "type": "string",
          "description": "Direction of positive X axis (e.g., along_neck, along_body)"
        },
        "y_axis": {
          "type": "string",
          "description": "Direction of positive Y axis (e.g., across_fretboard, across_body)"
        },
        "z_axis": {
          "type": "string",
          "description": "Direction of positive Z axis (e.g., into_material, out_of_material)"
        },
        "datum_point": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "description": "Numeric datum coordinates if applicable"
        }
      }
    },

    "provenance": {
      "type": "object",
      "required": ["cam_assist_version", "created_at"],
      "description": "Origin and creation metadata for this strategy package",
      "properties": {
        "source_spec_id": {
          "type": "string",
          "description": "Reference to source instrument specification"
        },
        "source_spec_hash": {
          "type": "string",
          "description": "Hash of source spec for change detection"
        },
        "cam_assist_version": {
          "type": "string",
          "description": "Version of CAM Assist that generated this strategy"
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "format": "date-time",
          "description": "Non-blank string holding the ISO-8601 timestamp of strategy creation. This schema enforces non-blankness only (minLength + pattern reject empty and whitespace-only); whether the format: date-time annotation is asserted depends on the consuming validator's configuration, so the ISO-8601 shape may go unchecked."
        },
        "created_by": {
          "type": "string",
          "description": "Identifier of creator (human or system)"
        }
      }
    },

    "operation_intent": {
      "type": "object",
      "required": ["operation_type", "target_feature", "cut_intent", "non_execution_declaration"],
      "description": "Semantic declaration of what this strategy intends to accomplish",
      "properties": {
        "operation_type": {
          "type": "string",
          "description": "Type of lutherie operation (fret_slots, truss_rod_channel, pickup_route, neck_pocket, etc.)"
        },
        "geometry_type": {
          "type": "string",
          "enum": ["2D", "2.5D", "3D"],
          "description": "Complexity class of operation geometry"
        },
        "strategy_complexity": {
          "type": "string",
          "enum": ["simple", "compound", "sequenced"],
          "description": "Manufacturing-strategy complexity class"
        },
        "target_feature": {
          "type": "string",
          "description": "The instrument feature this operation targets (fretboard, body, neck, etc.)"
        },
        "cut_intent": {
          "type": "string",
          "enum": ["slot", "pocket", "profile", "drill", "contour", "channel"],
          "description": "The geometric intent of the cut operation"
        },
        "non_execution_declaration": {
          "type": "boolean",
          "const": true,
          "description": "MUST be true. Declares this package does not execute machine operations."
        }
      }
    },

    "material_context": {
      "type": "object",
      "required": ["material_class"],
      "description": "Material information for parameter recommendations",
      "properties": {
        "material_class": {
          "type": "string",
          "enum": ["softwood", "hardwood", "exotic", "figured", "laminate", "composite", "unknown"],
          "description": "General material classification"
        },
        "species": {
          "type": "string",
          "description": "Specific wood species if known"
        },
        "hardness_janka": {
          "type": "integer",
          "description": "Janka hardness rating if known"
        },
        "grain_direction": {
          "type": "string",
          "description": "Grain orientation relative to operation"
        },
        "notes": {
          "type": "string",
          "description": "Additional material considerations"
        }
      }
    },

    "safety_boundary": {
      "type": "object",
      "required": ["non_execution_declaration", "human_review_required"],
      "description": "Safety declarations and execution boundaries",
      "properties": {
        "non_execution_declaration": {
          "type": "boolean",
          "const": true,
          "description": "MUST be true. This package does not generate executable machine code."
        },
        "human_review_required": {
          "type": "boolean",
          "const": true,
          "description": "MUST be true. Human review is required before any downstream execution."
        },
        "max_depth_inches": {
          "type": "number",
          "description": "Maximum cut depth referenced in this strategy"
        },
        "tool_diameter_inches": {
          "type": "number",
          "description": "Tool diameter referenced in this strategy"
        },
        "execution_authority_claim": {
          "type": "boolean",
          "const": false,
          "description": "MUST be false or absent. Strategy packages do not claim execution authority."
        }
      }
    },

    "geometry": {
      "type": "object",
      "required": ["dxf_file", "primary_layer"],
      "description": "DXF geometry file references",
      "properties": {
        "dxf_file": {
          "type": "string",
          "description": "Filename slot for DXF geometry. Presence of this field does not imply a DXF file was generated or packaged."
        },
        "primary_layer": {
          "type": "string",
          "description": "DXF layer containing primary operation geometry"
        },
        "reference_layers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional reference layers in DXF"
        },
        "generated": {
          "type": "boolean",
          "description": "When false, dxf_file is a contract filename only; no DXF file is generated or packaged."
        }
      }
    },

    "operation": {
      "type": "object",
      "required": ["type", "tool", "parameters"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Specific operation type (slot_cut, pocket, drill, etc.)"
        },
        "tool": {
          "type": "object",
          "properties": {
            "reference_type": {
              "type": "string",
              "enum": ["generic", "dimension_spec", "named"]
            },
            "tool_type": { "type": "string" },
            "diameter": { "type": "number" },
            "description": { "type": "string" },
            "required_dimensions": { "type": "object" },
            "alternatives": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "parameters": {
          "type": "object",
          "properties": {
            "depth": { "type": "number" },
            "width": { "type": "number" },
            "depth_per_pass": { "type": "number" },
            "feed_rate_ipm": { "type": "number" },
            "spindle_rpm": { "type": "integer" },
            "recommended": { "type": "object" },
            "basis": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "sequence": {
          "type": "string",
          "description": "Execution order description"
        }
      }
    },

    "positions": {
      "type": "array",
      "description": "Array of calculated positions (for positional operations)",
      "items": {
        "type": "object",
        "properties": {
          "index": { "type": "integer" },
          "fret": { "type": "integer" },
          "distance_from_nut": { "type": "number" },
          "x": { "type": "number" },
          "y": { "type": "number" }
        }
      }
    },

    "channel": {
      "type": "object",
      "description": "Open-path channel geometry intent for truss_rod_channel strategies",
      "properties": {
        "start": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "end": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "width": { "type": "number" },
        "depth": { "type": "number" },
        "length": { "type": "number" },
        "bottom_profile": { "type": "string" },
        "path_kind": { "type": "string" }
      }
    },

    "depth_strategy": {
      "type": "object",
      "description": "Deterministic depth-pass strategy. Advisory; not machine motion.",
      "properties": {
        "final_depth": { "type": "number" },
        "maximum_pass_depth": { "type": "number" },
        "pass_count": { "type": "integer" },
        "passes": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },

    "strategy_phases": {
      "type": "array",
      "description": "Ordered manufacturing-strategy phases. Not a machine program.",
      "items": {
        "type": "object",
        "properties": {
          "phase_id": { "type": "string" },
          "order": { "type": "integer" },
          "intent": { "type": "string" },
          "recommended_tool": { "type": "object" },
          "depth_strategy": { "type": "object" }
        }
      }
    },

    "tool_compatibility": {
      "type": "object",
      "description": "Advisory geometric fit of the recommended tool to the feature",
      "properties": {
        "status": { "type": "string" },
        "recommendation": { "type": "string" },
        "tool_diameter": { "type": "number" },
        "channel_width": { "type": "number" },
        "width_strategy": { "type": "string" },
        "width_clearing_required": {
          "type": "boolean",
          "description": "True when the recommended tool is narrower than the channel and width clearing is required. Advisory; no cutter-center offsets are generated."
        }
      }
    },

    "setup_assumptions": {
      "type": "object",
      "description": "Advisory workholding and access assumptions. Not fixture or WCS authority."
    },

    "review_requirements": {
      "type": "object",
      "description": "Human review items and dimensional evidence for this strategy"
    },

    "calculation_basis": {
      "type": "object",
      "description": "Mathematical basis for calculated values",
      "properties": {
        "formula": { "type": "string" },
        "scale_length": { "type": "number" },
        "temperament": { "type": "string" },
        "precision": { "type": "integer" }
      }
    },

    "warnings": {
      "type": "array",
      "description": "Warnings generated during strategy creation",
      "items": {
        "type": "object",
        "required": ["level", "code", "message"],
        "properties": {
          "level": {
            "type": "string",
            "enum": ["INFO", "CAUTION", "WARNING", "BLOCK"]
          },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "acknowledged": { "type": "boolean" },
          "acknowledgment_note": { "type": "string" }
        }
      }
    },

    "approval_state": {
      "type": "string",
      "enum": ["pending", "in_review", "approved", "rejected"],
      "description": "Current approval workflow state"
    },

    "approval": {
      "type": "object",
      "description": "Approval record (present when approved)",
      "properties": {
        "approver": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "identifier": { "type": "string" }
          }
        },
        "timestamp": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "format": "date-time",
          "description": "Non-blank string holding the ISO-8601 timestamp of the approval. This schema enforces non-blankness only (minLength + pattern reject empty and whitespace-only); whether the format: date-time annotation is asserted depends on the consuming validator's configuration, so the ISO-8601 shape may go unchecked."
        },
        "checklist_completion": {
          "type": "object"
        },
        "notes": { "type": "string" }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "required": ["operation_intent"],
        "properties": {
          "operation_intent": {
            "type": "object",
            "required": ["operation_type"],
            "properties": {
              "operation_type": { "const": "truss_rod_channel" }
            }
          }
        }
      },
      "then": {
        "required": [
          "channel",
          "depth_strategy",
          "strategy_phases",
          "tool_compatibility",
          "review_requirements"
        ],
        "properties": {
          "geometry": {
            "type": "object",
            "required": ["dxf_file", "primary_layer", "generated"],
            "properties": {
              "dxf_file": { "const": "geometry.dxf" },
              "primary_layer": { "const": "TRUSS_ROD_CHANNEL" },
              "generated": { "const": false }
            }
          },
          "strategy_phases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1
          },
          "tool_compatibility": {
            "type": "object",
            "required": ["width_strategy", "width_clearing_required"],
            "properties": {
              "width_clearing_required": { "type": "boolean" }
            }
          },
          "review_requirements": {
            "type": "object",
            "required": ["evidence"],
            "properties": {
              "evidence": {
                "type": "object",
                "required": ["blank_thickness", "residual_material"],
                "properties": {
                  "blank_thickness": {
                    "type": "number",
                    "description": "Required blank thickness. Residual material is blank_thickness minus channel depth."
                  },
                  "residual_material": {
                    "type": "number",
                    "description": "Must equal blank_thickness minus final channel depth and must be greater than zero."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
