{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cam-assist.lutherie/schemas/operation.schema.json",
  "title": "CAM Assist Operation Schema",
  "description": "Defines a lutherie manufacturing operation request",
  "type": "object",
  "required": ["operation_type", "instrument_spec", "parameters"],

  "properties": {
    "operation_id": {
      "type": "string",
      "description": "Unique identifier for this operation request"
    },

    "operation_type": {
      "type": "string",
      "enum": [
        "fret_slots",
        "pickup_route",
        "neck_pocket",
        "truss_rod_channel",
        "control_cavity",
        "bridge_recess",
        "tuner_holes",
        "bridge_pin_holes",
        "body_outline",
        "headstock_outline",
        "binding_channel"
      ],
      "description": "Type of lutherie operation"
    },

    "geometry_type": {
      "type": "string",
      "enum": ["2D", "2.5D", "3D"],
      "description": "Complexity class of operation geometry"
    },

    "strategy_complexity": {
      "type": "string",
      "enum": ["simple", "compound", "sequenced"],
      "description": "Manufacturing-strategy complexity class"
    },

    "precision_class": {
      "type": "string",
      "enum": ["I", "II", "III", "IV"],
      "description": "Required precision class (I=critical, IV=aesthetic)"
    },

    "instrument_spec": {
      "type": "object",
      "description": "Instrument specification relevant to this operation",
      "properties": {
        "instrument_type": {
          "type": "string",
          "description": "Type of instrument (guitar, bass, mandolin, etc.)"
        },
        "scale_length_inches": {
          "type": "number",
          "description": "Scale length in inches"
        },
        "fret_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "nut_width_inches": {
          "type": "number"
        },
        "body_width_inches": {
          "type": "number"
        },
        "fretboard_width_nut_inches": {
          "type": "number"
        },
        "fretboard_width_last_inches": {
          "type": "number"
        }
      }
    },

    "parameters": {
      "type": "object",
      "description": "Operation-specific parameters",
      "properties": {
        "depth_inches": {
          "type": "number",
          "description": "Cut depth in inches"
        },
        "width_inches": {
          "type": "number",
          "description": "Cut width in inches (e.g., slot width)"
        },
        "extension_beyond_edge_inches": {
          "type": "number",
          "description": "How far geometry extends beyond workpiece edge"
        },
        "start": {
          "type": "object",
          "description": "Open-path start point in the operation coordinate frame. For truss_rod_channel this is an XY point; depth is parameters.depth_inches, not Z.",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "end": {
          "type": "object",
          "description": "Open-path end point in the operation coordinate frame",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "maximum_pass_depth_inches": {
          "type": "number",
          "description": "Maximum depth per pass for depth-strategy calculation"
        },
        "blank_thickness_inches": {
          "type": "number",
          "description": "Blank thickness in inches. Residual material is blank thickness minus channel depth and must be greater than zero. The live creator request uses unit-agnostic blank_thickness; blank_thickness_inches is accepted as an alias only when units are inches."
        },
        "length_inches": {
          "type": "number",
          "description": "Cavity length in inches along X. Live creator request uses unit-agnostic cavity.length."
        },
        "corner_radius_inches": {
          "type": "number",
          "description": "Cavity corner radius in inches. Live creator request uses unit-agnostic cavity.corner_radius."
        },
        "finish_allowance_inches": {
          "type": "number",
          "description": "Wall-stock finish allowance in inches. Live creator request uses unit-agnostic roughing.finish_allowance."
        },
        "reference_point": {
          "type": "object",
          "description": "Cavity geometric center in the operation coordinate frame. For pickup_route this is an XY point; depth is parameters.depth_inches, not Z.",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        }
      }
    },

    "material_spec": {
      "type": "object",
      "description": "Material specification for feed/speed recommendations",
      "properties": {
        "material_class": {
          "type": "string",
          "enum": ["softwood", "hardwood", "exotic", "figured", "laminate", "composite"]
        },
        "species": {
          "type": "string",
          "description": "Specific wood species"
        },
        "hardness_janka": {
          "type": "integer",
          "description": "Janka hardness rating"
        }
      }
    },

    "tool_preference": {
      "type": "object",
      "description": "Optional tool preferences",
      "properties": {
        "tool_type": {
          "type": "string"
        },
        "tool_id": {
          "type": "string",
          "description": "Reference to shop tool library"
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": { "operation_type": { "const": "fret_slots" } }
      },
      "then": {
        "properties": {
          "instrument_spec": {
            "required": ["scale_length_inches", "fret_count"]
          },
          "parameters": {
            "required": ["depth_inches", "width_inches"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "operation_type": { "const": "truss_rod_channel" } }
      },
      "then": {
        "properties": {
          "geometry_type": { "const": "2.5D" },
          "strategy_complexity": { "const": "simple" },
          "parameters": {
            "required": ["depth_inches", "width_inches", "start", "end", "blank_thickness_inches"],
            "properties": {
              "start": {
                "type": "object",
                "required": ["x", "y"],
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              },
              "end": {
                "type": "object",
                "required": ["x", "y"],
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "operation_type": { "const": "pickup_route" } }
      },
      "then": {
        "properties": {
          "geometry_type": { "const": "2.5D" },
          "strategy_complexity": { "const": "compound" },
          "parameters": {
            "required": [
              "depth_inches",
              "width_inches",
              "length_inches",
              "corner_radius_inches",
              "finish_allowance_inches",
              "reference_point"
            ],
            "properties": {
              "reference_point": {
                "type": "object",
                "required": ["x", "y"],
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
